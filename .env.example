# SpeakWell — Environment Variables
# Copy this file to backend/.env and fill in your API keys
# DO NOT put real keys in this file — it is safe to commit

# === Required ===

# OpenAI API Key — used for Whisper speech-to-text
OPENAI_API_KEY=sk...

# Google Gemini API Key — used for conversation, corrections, TTS, and session analysis
GEMINI_API_KEY=A...

# === Optional ===

# Gemini TTS voice (Aoede, Charon, Fenrir, Kore, Puck)
GEMINI_TTS_VOICE=Aoede

# Gemini model for conversation and analysis
GEMINI_MODEL=gemini-2.0-flash

# Gemini TTS model (preview feature)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
