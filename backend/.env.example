# SpeakWell Backend — Environment Variables
# Copy this file to .env and fill in your keys

# OpenAI API Key (used for Whisper speech-to-text)
OPENAI_API_KEY=sk-...

# Google Gemini API Key (used for conversation, corrections, TTS, and analysis)
GEMINI_API_KEY=AIza...

# Optional: Gemini TTS voice name
# Options: Aoede, Charon, Fenrir, Kore, Puck
GEMINI_TTS_VOICE=Aoede

# Optional: Gemini model for conversation and analysis
GEMINI_MODEL=gemini-2.0-flash

GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Database Connection String
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/englishtutor
