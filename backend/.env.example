# Copy to .env and set your OpenAI API key and Firestore project.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# Firestore (required): all app data is stored here.
# Key: Firebase console > Project settings > Service accounts > Generate new private key.
FIRESTORE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIRESTORE_DATABASE_ID=   (only if you use a named database instead of "(default)")
